# Telegram 팀 채팅방
TELEGRAM_BOT_TOKEN=
TELEGRAM_BROADCASTING_CHAT_ID=
TELEGRAM_NEWSLETTER_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CHANNEL_AUTO_PUBLISH=true

# LLM 제공자
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 이미지 제작 에이전트
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium

# 블로그 배포 어댑터
# 티스토리 Open API는 공식 종료 안내가 있으므로 Playwright 브라우저 자동화로 게시합니다.
BLOG_PUBLISHER=tistory
TISTORY_BLOG_URL=https://chutzrit.tistory.com
TISTORY_MANAGE_URL=https://chutzrit.tistory.com/manage
TISTORY_WRITE_URL=https://chutzrit.tistory.com/manage/newpost
TISTORY_PUBLISH_MODE=public
TISTORY_AUTO_PUBLISH=true
PLAYWRIGHT_STORAGE_STATE=outputs/broadcasting/session/tistory-state.json
PLAYWRIGHT_HEADLESS=true

# LinkedIn 배포 어댑터
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REQUIRE_APPROVAL=true

# 콘텐츠 안전 기본값
PUBLIC_CONTENT_REQUIRE_APPROVAL=false

LINKEDIN_REDIRECT_URI=http://127.0.0.1:3000/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202602
LINKEDIN_AUTO_PUBLISH=true
